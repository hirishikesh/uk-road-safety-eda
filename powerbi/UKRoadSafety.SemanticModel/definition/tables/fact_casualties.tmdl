table fact_casualties
	lineageTag: 677fc1c8-28fa-505c-bbb1-16c9bd1dda82

	measure 'Casualties' = COUNTROWS ( fact_casualties )
		formatString: #,0
		displayFolder: Casualties
		lineageTag: 5292427e-a152-589c-9c82-cc50db9c83ce

	measure 'Fatalities' = SUM ( fact_casualties[is_fatal] )
		formatString: #,0
		displayFolder: Casualties
		lineageTag: da5b3090-8566-5253-af77-d53107ce1547

	measure 'KSI Casualties (adj)' = SUM ( fact_casualties[ksi_adjusted] )
		formatString: #,0
		displayFolder: Casualties
		lineageTag: e150d5d4-b442-56fc-96c2-37aa333198e8

	measure 'Casualty KSI Rate (adj)' = DIVIDE ( [KSI Casualties (adj)], [Casualties] )
		formatString: 0.0%
		displayFolder: Casualties
		lineageTag: 4442e13b-c69e-5671-9f30-a88c162ca43f

	measure 'Deaths per 1,000 Casualties' = DIVIDE ( [Fatalities], [Casualties] ) * 1000
		formatString: 0.0
		displayFolder: Casualties
		lineageTag: 70ee93e9-1ae2-577e-bb09-772f060a3fe9

	measure 'Share of Casualties' = DIVIDE ( [Casualties], CALCULATE ( [Casualties], ALLSELECTED ( fact_casualties[road_user] ) ) )
		formatString: 0.0%
		displayFolder: Casualties
		lineageTag: 8d6c6a1c-ccd1-5e59-a282-bc2c9e345e0e

	measure 'Share of Fatalities' = DIVIDE ( [Fatalities], CALCULATE ( [Fatalities], ALLSELECTED ( fact_casualties[road_user] ) ) )
		formatString: 0.0%
		displayFolder: Casualties
		lineageTag: 3ca72d9e-ef7c-5854-954e-b6e355fd701a

