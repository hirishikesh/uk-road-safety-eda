	partition fact_casualties = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_casualties.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"collision_index", type text}, {"vehicle_reference", Int64.Type}, {"casualty_reference", Int64.Type}, {"casualty_class", type text}, {"sex", type text}, {"age", type number}, {"age_group", type text}, {"casualty_type", type text}, {"road_user", type text}, {"severity", type text}, {"is_fatal", Int64.Type}, {"is_serious", Int64.Type}, {"adj_serious", type number}, {"ksi_adjusted", type number}, {"imd_decile", type number}, {"injury_based_reporting", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
