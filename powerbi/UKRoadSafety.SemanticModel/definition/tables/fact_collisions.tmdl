	partition fact_collisions = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_collisions.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"collision_index", type text}, {"date", type date}, {"hour", Int64.Type}, {"time_band", type text}, {"severity", type text}, {"is_fatal", Int64.Type}, {"is_serious", Int64.Type}, {"adj_serious", type number}, {"ksi_adjusted", type number}, {"reporting_system", type text}, {"number_of_vehicles", Int64.Type}, {"number_of_casualties", Int64.Type}, {"country", type text}, {"police_force", type text}, {"local_authority", type text}, {"urban_rural", type text}, {"road_class", type text}, {"road_type", type text}, {"speed_limit", type number}, {"junction_detail", type text}, {"junction_control", type text}, {"pedestrian_crossing", type text}, {"light_conditions", type text}, {"light", type text}, {"weather_conditions", type text}, {"weather", type text}, {"high_winds", Int64.Type}, {"road_surface", type text}, {"trunk_road", type text}, {"latitude", type number}, {"longitude", type number}, {"speed_limit_label", type text}, {"involves_motorcycle", Int64.Type}, {"involves_pedal_cycle", Int64.Type}, {"involves_hgv", Int64.Type}, {"involves_bus", Int64.Type}, {"involves_escooter", Int64.Type}, {"young_driver", Int64.Type}, {"older_driver", Int64.Type}, {"driver_left_carriageway", Int64.Type}, {"pedestrian_casualty", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
