table fact_collisions
	lineageTag: bc06f0ee-dcd4-501b-a9ed-db4e940cb53c

	measure 'Collisions' = COUNTROWS ( fact_collisions )
		formatString: #,0
		displayFolder: Collisions
		lineageTag: 42dbe34d-2a7b-56ce-9522-f96c06bda673

	measure 'Fatal Collisions' = SUM ( fact_collisions[is_fatal] )
		formatString: #,0
		displayFolder: Collisions
		lineageTag: af0c7322-2d3b-544e-9514-d101b83ab8a1

	measure 'KSI Collisions (adj)' = SUM ( fact_collisions[ksi_adjusted] )
		formatString: #,0
		displayFolder: Collisions
		lineageTag: e47cfb85-5430-5339-bc24-0017fe70d9be

	measure 'KSI Rate (adj)' = DIVIDE ( [KSI Collisions (adj)], [Collisions] )
		formatString: 0.0%
		displayFolder: Collisions
		lineageTag: 29e55f42-c29a-5431-9802-a65c305280ab

	measure 'KSI Rate (recorded)' = DIVIDE ( CALCULATE ( [Collisions], fact_collisions[severity] <> "Slight" ), [Collisions] )
		formatString: 0.0%
		displayFolder: Collisions
		lineageTag: fc1a7236-c621-56c7-9028-305ccbcaa8e6

	measure 'Fatal per 1,000 Collisions' = DIVIDE ( [Fatal Collisions], [Collisions] ) * 1000
		formatString: 0.0
		displayFolder: Collisions
		lineageTag: dabcfbb1-210a-5d95-a5c7-699345b573c2

	measure 'Injury-based Reporting %' = DIVIDE ( CALCULATE ( [Collisions], fact_collisions[reporting_system] = "Injury-based (CRASH)" ), [Collisions] )
		formatString: 0.0%
		displayFolder: Data quality
		lineageTag: 5174962e-27d5-5f01-a53c-c4a50cbbd822

	measure 'Collisions YoY %' =
			VAR cur = [Collisions]
			VAR prev = CALCULATE ( [Collisions], DATEADD ( dim_date[date], -1, YEAR ) )
			RETURN IF ( NOT ISBLANK ( prev ), DIVIDE ( cur - prev, prev ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Collisions
		lineageTag: 42b8a23a-4c1e-512f-b158-f33381c139c7

