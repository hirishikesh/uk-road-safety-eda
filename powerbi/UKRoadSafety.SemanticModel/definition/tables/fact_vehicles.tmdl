table fact_vehicles
	lineageTag: 61e352fc-c4e4-597b-a100-6d43141d647e

	measure 'Vehicles' = COUNTROWS ( fact_vehicles )
		formatString: #,0
		displayFolder: Vehicles
		lineageTag: 9384b257-a671-59e3-b2bd-175f01b38dbb

	measure 'Driver Collision KSI Rate (adj)' =
			AVERAGEX ( FILTER ( fact_vehicles, fact_vehicles[is_motor_vehicle] = 1 ),
			    RELATED ( fact_collisions[ksi_adjusted] ) )
		formatString: 0.0%
		displayFolder: Vehicles
		lineageTag: c8a2c191-5c06-5adb-8d83-d704a2c3a584

	column collision_index
		dataType: string
		isHidden
