	partition fact_vehicles = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_vehicles.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"collision_index", type text}, {"vehicle_reference", Int64.Type}, {"vehicle_type", type text}, {"vehicle_group", type text}, {"vehicle_manoeuvre", type text}, {"journey_purpose", type text}, {"first_point_of_impact", type text}, {"left_carriageway", type text}, {"sex_of_driver", type text}, {"age_of_driver", type number}, {"driver_age_group", type text}, {"propulsion", type text}, {"age_of_vehicle", type number}, {"is_escooter", Int64.Type}, {"is_motor_vehicle", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
